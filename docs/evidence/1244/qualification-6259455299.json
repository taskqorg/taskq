      "workflow": {
        "sha": "bd303210fc227a06af21fb1ed8cb9ca95f282f85",
        "content": "# \u00a7 7: PR checks and merge_group CI; publication requires green CI on the merge result.\nname: tests\non:\n  workflow_dispatch:\n  push:\n    branches: [main]\n    tags: ['v*']\n  pull_request:\n  merge_group:\n    types: [checks_requested]\npermissions:\n  contents: read\nenv:\n  CHECK_BASE: ${{ github.event.merge_group.base_sha || github.event.pull_request.base.sha || github.event.before || 'HEAD^' }}\n  CHECK_FULL: ${{ github.event_name == 'workflow_dispatch' || github.ref_type == 'tag' }}\njobs:\n  plan:\n    runs-on: ubuntu-latest\n    outputs:\n      scope: ${{ steps.plan.outputs.scope }}\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - id: plan\n        run: python3 scripts/check.py --plan >> \"$GITHUB_OUTPUT\"\n      - run: git diff --check\n      - run: python3 scripts/check.test.py\n  rust:\n    needs: plan\n    if: needs.plan.outputs.scope != 'docs'\n    strategy:\n      matrix:\n        os: [ubuntu-latest, macos-latest, windows-latest]\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 16\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - run: python3 scripts/check.py\n  windows-gnu:\n    needs: plan\n    if: needs.plan.outputs.scope == 'full'\n    runs-on: windows-latest\n    timeout-minutes: 16\n    steps:\n      - uses: actions/checkout@v4\n      - run: rustup toolchain install stable-x86_64-pc-windows-gnu\n      - run: npm ci --ignore-scripts --no-audit --no-fund\n      - run: cargo +stable-x86_64-pc-windows-gnu test --locked --bin taskq platform::tests::installed_windows_release_starts_without_build_paths -- --exact --show-output\n  shots:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - run: |\n          rc=0; docs/shots/check.sh || rc=$?\n          [ $rc = 2 ] && { echo '::warning::README shots are stale; run the README shots workflow'; exit 0; }\n          exit $rc\n  tests:\n    needs: [plan, rust, windows-gnu, shots]\n    if: always()\n    runs-on: ubuntu-latest\n    steps:\n      - env:\n          PLAN: ${{ needs.plan.result }}\n          SCOPE: ${{ needs.plan.outputs.scope }}\n          RUST: ${{ needs.rust.result }}\n          GNU: ${{ needs.windows-gnu.result }}\n          SHOTS: ${{ needs.shots.result }}\n        run: |\n          test \"$PLAN\" = success && test \"$SHOTS\" = success\n          case \"$SCOPE\" in\n            docs) test \"$RUST\" = skipped && test \"$GNU\" = skipped ;;\n            web) test \"$RUST\" = success && test \"$GNU\" = skipped ;;\n            full) test \"$RUST\" = success && test \"$GNU\" = success ;;\n            *) exit 1 ;;\n          esac\n"
      }
    }
