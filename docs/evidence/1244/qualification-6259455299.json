        "content": "name: Test\non: [push, pull_request, workflow_dispatch, merge_group]\npermissions:\n  contents: read\njobs:\n  rust:\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-latest, windows-latest, macos-latest]\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 15\n    env:\n      AGENTQ_SELFTEST_OFFLINE: '1'\n    steps:\n      - uses: actions/checkout@v6\n      - run: rustup default stable\n      - run: python tests/client_compression_check.py\n      - run: python tests/provider_adapter.py\n      - run: python tests/hermes_adapter.py\n      - run: python tests/telemetry_qualification.py\n      - run: cargo test --locked\n      - run: cargo run --locked -- selftest\n"
      }
