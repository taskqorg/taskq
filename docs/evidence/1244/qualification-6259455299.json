      "workflow": {
        "sha": "08656cee2768c36b149fa166e7138335756d9648",
        "content": "name: tests\non:\n  push:\n    branches: [main, 'taskq-*']\n  pull_request:\n  merge_group:\n    types: [checks_requested]\n  workflow_dispatch:\npermissions:\n  contents: read\nenv:\n  CHECK_BASE: ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before || 'HEAD^' }}\n  CHECK_FULL: ${{ github.event_name == 'workflow_dispatch' }}\njobs:\n  plan:\n    runs-on: ubuntu-latest\n    outputs:\n      scope: ${{ steps.plan.outputs.scope }}\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - id: plan\n        run: python3 scripts/check.py --plan >> \"$GITHUB_OUTPUT\"\n      - run: git diff --check\n      - run: python3 scripts/check.test.py\n  rust:\n    needs: plan\n    if: needs.plan.outputs.scope != 'docs'\n    strategy:\n      matrix:\n        os: [ubuntu-latest, macos-latest, windows-latest]\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 16\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - run: python3 scripts/check.py\n  tests:\n    needs: [plan, rust]\n    if: always()\n    runs-on: ubuntu-latest\n    steps:\n      - env:\n          PLAN: ${{ needs.plan.result }}\n          SCOPE: ${{ needs.plan.outputs.scope }}\n          RUST: ${{ needs.rust.result }}\n        run: |\n          test \"$PLAN\" = success\n          case \"$SCOPE\" in\n            docs) test \"$RUST\" = skipped ;;\n            full) test \"$RUST\" = success ;;\n            *) exit 1 ;;\n          esac\n"
      }
    },
