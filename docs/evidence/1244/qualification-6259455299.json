        "content": "name: check\non:\n  pull_request:\n  merge_group:\n    types: [checks_requested]\n  push:\n    branches: [main]\npermissions:\n  contents: read\njobs:\n  check:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - run: python3 caveman/scripts/check.py\n      - run: git diff --check ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before }} ${{ github.sha }}\n"
      }
    },
