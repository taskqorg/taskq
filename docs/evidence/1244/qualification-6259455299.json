      "workflow": {
        "sha": "a5daec3751188f3b77eb33b3df67cc10578c0c3e",
        "content": "# dashq.md D2 Release: static Linux binary per arch, SHA256SUMS, latest.json. A failing selftest publishes nothing.\n# Pull requests run the same build and selftest (required checks on main); only a tag publishes.\nname: release\non:\n  push:\n    tags: ['v*']\n  pull_request:\n  merge_group:\n    types: [checks_requested]\npermissions:\n  contents: read\njobs:\n  build:\n    strategy:\n      matrix:\n        include:\n          - os: ubuntu-latest\n            target: x86_64-unknown-linux-musl\n            name: linux-x86_64\n          - os: ubuntu-24.04-arm\n            target: aarch64-unknown-linux-musl\n            name: linux-aarch64\n    runs-on: ${{ matrix.os }}\n    env:\n      DASHQ_SELFTEST_OFFLINE: '1'\n      TARGET: ${{ matrix.target }}\n    steps:\n      - uses: actions/checkout@v4\n      - run: sudo apt-get update && sudo apt-get install -y musl-tools\n      - run: rustup update stable --no-self-update && rustup default stable && rustup target add \"$TARGET\"\n      - name: Tag equals Cargo.toml version\n        run: |\n          ver=\"$(sed -n 's/^version = \"\\(.*\\)\"$/\\1/p' Cargo.toml | head -n 1)\"\n          test -n \"$ver\"\n          if [ \"$GITHUB_REF_TYPE\" = tag ]; then test \"${GITHUB_REF_NAME#v}\" = \"$ver\"; fi\n          echo \"VER=$ver\" >> \"$GITHUB_ENV\"\n      # Tests need headless Chrome (snapshot PNG): ubuntu-latest ships it, the arm runner does not.\n      # The arm artifact is still gated by its own selftest below. On a pull request tests.yml runs them.\n      - if: matrix.name == 'linux-x86_64' && github.ref_type == 'tag'\n        run: cargo test --locked\n      - run: cargo build --locked --release --target \"$TARGET\"\n      - name: Selftest and stage\n        run: |\n          bin=\"target/$TARGET/release/dashq\"\n          file \"$bin\" | grep -Eq 'static(ally|-pie) linked'\n          \"$bin\" selftest\n          mkdir dist\n          cp \"$bin\" \"dist/dashq-$VER-${{ matrix.name }}\"\n      - if: github.ref_type == 'tag'\n        uses: actions/upload-artifact@v4\n        with:\n          name: ${{ matrix.name }}\n          path: dist/*\n  publish:\n    if: github.ref_type == 'tag'\n    needs: build\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/download-artifact@v4\n        with:\n          path: dist\n          merge-multiple: true\n      - name: Describe\n        run: |\n          ver=\"${GITHUB_REF_NAME#v}\"\n          cd dist\n          sha256sum dashq-* > SHA256SUMS\n          python3 - \"$ver\" <<'PY'\n          import json, os, sys\n          ver = sys.argv[1]\n          files = {n[len(f'dashq-{ver}-'):]: n for n in sorted(os.listdir('.')) if n.startswith(f'dashq-{ver}-')}\n          assert set(files) == {'linux-x86_64', 'linux-aarch64'}, files\n          json.dump({'version': ver, 'files': files}, open('latest.json', 'w'), indent=1)\n          PY\n      - name: Publish\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: gh release create \"$GITHUB_REF_NAME\" dist/* --repo \"$GITHUB_REPOSITORY\" --title \"DashQ $GITHUB_REF_NAME\" --notes \"dashq $GITHUB_REF_NAME\"\n"
      }
    },
