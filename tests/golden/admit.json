[
  {"name": "unlabeled work prefers claude then uses codex", "limits": {"claude": 1, "codex": 2}, "running": {}, "tasks": 2,
   "expect": ["claude", "codex"]},
  {"name": "a busy claude falls back to codex", "limits": {"claude": 1, "codex": 2}, "running": {"claude": 1}, "tasks": 1,
   "expect": ["codex"]},
  {"name": "run-codex waits for codex", "limits": {"claude": 2, "codex": 1}, "running": {}, "tasks": 2, "labels": ["run-codex"],
   "expect": ["codex", null]},
  {"name": "legacy prefer-codex reads as run-codex", "limits": {"claude": 2, "codex": 1}, "running": {"codex": 1}, "tasks": 1, "labels": ["prefer-codex"],
   "expect": [null]},
  {"name": "legacy prefer-claude reads as none", "limits": {"claude": 1, "codex": 2}, "running": {}, "tasks": 2, "labels": ["prefer-claude"],
   "expect": ["claude", "codex"]},
  {"name": "run-* wins over prefer-*", "limits": {"claude": 2, "codex": 2}, "running": {}, "tasks": 1, "labels": ["run-claude", "prefer-codex"],
   "expect": ["claude"]},
  {"name": "both prefer labels are ignored with one log line", "limits": {"claude": 2, "codex": 2}, "running": {}, "tasks": 1, "labels": ["prefer-codex", "prefer-claude"],
   "expect": ["claude"], "ignored": 1},
  {"name": "disabled Claude falls back without changing limits", "limits": {"claude": 0, "codex": 1}, "running": {}, "tasks": 1,
   "expect": ["codex"]},
  {"name": "disabled explicit Claude pin waits", "limits": {"claude": 0, "codex": 1}, "running": {}, "tasks": 1, "labels": ["run-claude"],
   "expect": [null]},
  {"name": "both full leave work ready", "limits": {"claude": 0, "codex": 0}, "running": {}, "tasks": 1,
   "expect": [null]},
  {"name": "code type does not create a pin", "limits": {"claude": 0, "codex": 1}, "running": {}, "tasks": 1, "labels": ["code"],
   "expect": ["codex"]}
